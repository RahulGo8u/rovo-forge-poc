# Required for generated SQL when templates do not match or when the caller forces generated_only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_OUTPUT_TOKENS=8192

QUERY_PLANNER_MODE=auto
NL2SQL_MAX_TABLES=12
NL2SQL_ROW_LIMIT=200
PORT=10001

# Optional runtime/debug values.
APP_NAME=human-to-sql-service
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Used only by the offline catalog extractor:
SQLSERVER_DB01_HOST=DB01NODE1
SQLSERVER_DB02_HOST=DB02NODE1
SQLSERVER_ODBC_DRIVER=ODBC Driver 17 for SQL Server
